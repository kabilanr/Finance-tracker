# Postgres connection string. On Neon, use the pooled connection string from Dashboard > Connect.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random secret used to sign login sessions. Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Random secret that Vercel Cron sends to /api/cron/recurring. Generate one with: openssl rand -base64 32
CRON_SECRET="replace-with-another-long-random-string"

# Time zone used to decide what "today" is (defaults to Asia/Kolkata).
# APP_TIME_ZONE="Asia/Kolkata"
